<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Données de base réalistes (cahier des charges, section 5.2).
         noupdate="1" : une mise à jour du module (-u predimaint) ne réécrit pas
         ces enregistrements, pour ne pas écraser les modifications faites dans Odoo
         ni les scores envoyés par Spark batch.
         Les identifiants capteur (PRESSE-01...) sont repris par le simulateur Big Data. -->
    <data noupdate="1">

        <!-- Équipes -->
        <record id="team_mecanique" model="maintenance.team">
            <field name="name">Équipe mécanique</field>
        </record>
        <record id="team_electrique" model="maintenance.team">
