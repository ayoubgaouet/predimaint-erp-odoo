        <!-- Seuils par catégorie (alerte / critique) -->
        <record id="threshold_presses_temperature" model="predimaint.sensor.threshold">
            <field name="category_id" ref="category_presses"/>
            <field name="measure_type">temperature</field>
            <field name="alert_threshold">60</field>
            <field name="critical_threshold">75</field>
            <field name="unit">°C</field>
